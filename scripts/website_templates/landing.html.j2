<!DOCTYPE html>
<html lang="{{ language | default('ru') }}" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{{ site_title }} — {{ site_subtitle }}</title>
  <meta
    name="description"
    content="{{ ui.hero_sub | default('Практическое руководство и локальный интерактивный справочник по Codex CLI') }}"
  />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
  <link rel="stylesheet" href="assets/vendor/fonts/fonts.css" />
  <link rel="stylesheet" href="assets/landing.css" />
  <script>
    // Apply the saved theme before paint to avoid flash of unstyled content.
    (function () {
      try {
        var saved = localStorage.getItem('codex-course-theme') || localStorage.getItem('claude-howto-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>
  <script>
    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');
  </script>
  <script src="assets/progress.js" defer></script>
  <script src="assets/landing.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#roadmap">{{ ui.skip_to_roadmap | default('Перейти к учебному маршруту') }}</a>

  <noscript>
    <div style="max-width: 900px; margin: 1.5rem auto; padding: 1rem 1.25rem; border-radius: 8px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.4); color: #dc2626; font-size: 0.9rem;">
      {{ ui.noscript_warning | default('Внимание: JavaScript отключен. Текстовые материалы доступны полностью, однако интерактивные тесты и сохранение прогресса требуют включенного JS.') }}
    </div>
  </noscript>

  {# ============ Sticky nav ============ #}
  <header class="nav" id="top">
    <div class="nav-inner">
      <a class="nav-brand" href="index.html" aria-label="Codex CLI Course">
        <span style="font-weight: 700; font-size: 1.15rem; color: var(--color-brand, #2563eb);">Codex CLI</span>
      </a>
      <nav class="nav-links" id="nav-menu" aria-label="Primary">
        <a href="#why">{{ ui.nav_why | default('О курсе') }}</a>
        <a href="#roadmap">{{ ui.nav_progress | default('Маршрут') }}</a>
        <a href="{{ guide_url }}">{{ ui.nav_reference | default('Справочник') }}</a>
        <a href="{{ repo_url }}" target="_blank" rel="noopener noreferrer">{{ ui.nav_github | default('GitHub') }}</a>
      </nav>
      <div class="nav-actions">
        <a class="btn btn-primary btn-sm nav-cta" href="#roadmap">{{ ui.btn_start | default('Начать') }}</a>
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Переключить тему"
        >
          <svg class="ti-sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10" cy="10" r="4" />
            <path d="M10 1.8v2.2M10 16v2.2M1.8 10H4M16 10h2.2M4.2 4.2l1.6 1.6M14.2 14.2l1.6 1.6M15.8 4.2l-1.6 1.6M5.8 14.2l-1.6 1.6" stroke-linecap="round" />
          </svg>
          <svg class="ti-moon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </button>
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-menu"
          aria-label="Меню навигации"
        >
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path class="menu-open" d="M3 5.5h14M3 10h14M3 14.5h14" stroke-linecap="round" />
            <path class="menu-close" d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    {# ============ Hero ============ #}
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow-row reveal" style="--d: 0s">
            <p class="eyebrow">~/codex-cli · практический курс</p>
            {% if version %}<span class="version-pill">Codex v{{ version }}</span>{% endif %}
          </div>
          <h1 class="hero-title reveal" style="--d: 0.08s">
            {{ ui.hero_title | default('Освойте <em>Codex CLI</em><br />на практике') | safe }}
          </h1>
          <p class="hero-sub reveal" style="--d: 0.16s">
            {{ ui.hero_sub | default('От базовых команд до безопасной разработки, AGENTS.md, навыков и автоматизации — интерактивные уроки, проверенные шаблоны и автономный учебный маршрут.') }}
          </p>
          <div class="hero-cta reveal" style="--d: 0.24s">
            <a class="btn btn-primary" href="#roadmap">{{ ui.btn_start | default('Начать обучение') }}</a>
            <a class="btn btn-ghost" href="{{ guide_url }}">{{ ui.nav_reference | default('Справочник') }}</a>
          </div>
          <dl class="hero-stats reveal" style="--d: 0.32s">
            <div class="stat">
              <dt>{{ ui.stat_modules | default('Модулей') }}</dt>
              <dd>{{ module_count }}</dd>
            </div>
            <div class="stat">
              <dt>{{ ui.stat_time | default('Время') }}</dt>
              <dd>10–12&nbsp;ч</dd>
            </div>
            <div class="stat">
              <dt>{{ ui.stat_offline | default('Офлайн') }}</dt>
              <dd>100%</dd>
            </div>
          </dl>
        </div>

        <div
          class="hero-term reveal"
          style="--d: 0.2s"
          role="img"
          aria-label="Терминальная запись сессии Codex CLI"
        >
          <div class="term">
            <div class="term-bar">
              <span class="term-dot"></span>
              <span class="term-dot"></span>
              <span class="term-dot"></span>
              <span class="term-title">~/project — codex</span>
            </div>
            <div class="term-body" id="terminal">
              <div class="t-line" data-t="cmd"><span class="t-pp">$</span><span class="t-tt">codex</span></div>
              <div class="t-line" data-t="out" data-c="dim">Codex CLI v0.160.0 · working in ~/project</div>
              <div class="t-line" data-t="cmd"><span class="t-pp t-pp-in">&gt;</span><span class="t-tt">исправь баг в api и запусти тесты</span></div>
              <div class="t-line" data-t="out" data-c="info">→ план: 1. локализация 2. точечный diff 3. verify</div>
              <div class="t-line" data-t="out" data-c="ok">✓ AGENTS.md загружен (правила проекта соблюдены)</div>
              <div class="t-line" data-t="cmd"><span class="t-pp t-pp-in">&gt;</span><span class="t-tt">python scripts/verify.py</span></div>
              <div class="t-line" data-t="out" data-c="ok">✓ tests passed (14/14) · sandbox: workspace-write</div>
              <div class="t-line" data-t="cmd"><span class="t-pp">$</span><span class="t-tt"></span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {# ============ Why / value ============ #}
    <section class="section" id="why">
      <p class="kicker reveal">Особенности курса</p>
      <h2 class="section-title reveal">Практика вместо теории</h2>
      <div class="cards">
        <article class="card reveal">
          <div class="card-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" />
              <path d="M10 6.5h4a3 3 0 0 1 3 3V14M14 17.5h-4a3 3 0 0 1-3-3V10" />
            </svg>
          </div>
          <h3>100% Офлайн</h3>
          <p>
            Все материалы, упражнения и тесты работают локально без обязательного подключения к внешней сети.
          </p>
        </article>
        <article class="card reveal" style="--d: 0.08s">
          <div class="card-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="8" width="12" height="12" rx="2" />
              <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
            </svg>
          </div>
          <h3>Проверенные шаблоны</h3>
          <p>
            Готовые конфигурации AGENTS.md, учебные навыки и stdio MCP примеры, проверенные на совместимость с версией 0.160.0.
          </p>
        </article>
        <article class="card reveal" style="--d: 0.16s">
          <div class="card-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="6" cy="19" r="2.5" />
              <circle cx="18" cy="5" r="2.5" />
              <path d="M8 17.5 10 15a10 10 0 0 1 6-7.5" />
              <path d="M8.5 19H15" stroke-dasharray="2 2.6" />
            </svg>
          </div>
          <h3>Последовательный маршрут</h3>
          <p>
            Десять модулей в порядке возрастания сложности — от базового запуска до продвинутых расширений и итоговой практики.
          </p>
        </article>
        <article class="card reveal" style="--d: 0.24s">
          <div class="card-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11.5 11 14l4.5-5" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </div>
          <h3>Наставник $learn</h3>
          <p>
            Встроенный в Codex CLI обучающий наставник с пошаговыми подсказками и проверкой упражнений.
          </p>
        </article>
      </div>
    </section>

    {# ============ Roadmap ============ #}
    <section class="section roadmap" id="roadmap">
      <p class="kicker reveal">Учебный маршрут</p>
      <h2 class="section-title reveal">Десять модулей, один путь</h2>
      <p class="section-sub reveal">
        Три уровня, {{ module_count }} модулей, {{ lesson_count }} уроков.
        Прогресс сохраняется локально в браузере — отмечайте шаги по мере прохождения.
      </p>

      <div class="progress-panel reveal" id="progress-panel">
        <div class="ring-wrap" role="img" aria-label="Общий прогресс">
          <svg class="ring" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="ring-bg" cx="60" cy="60" r="52" />
            <circle class="ring-fg" id="ring-fg" cx="60" cy="60" r="52" />
          </svg>
          <div class="ring-label">
            <span class="ring-pct" id="ring-pct">0%</span>
            <span class="ring-cap">{{ ui.status_done | default('пройдено') }}</span>
          </div>
        </div>
        <div class="progress-mid">
          <p class="counts">
            <span><b id="c-done">0</b> {{ ui.status_done | default('выполнено') }}</span>
            <span class="counts-sep" aria-hidden="true">·</span>
            <span><b id="c-prog">0</b> {{ ui.status_in_progress | default('в процессе') }}</span>
            <span class="counts-sep" aria-hidden="true">·</span>
            <span><b id="c-todo">{{ lesson_count }}</b> {{ ui.status_not_started | default('не начато') }}</span>
          </p>
          <div class="progress-actions">
            <a class="btn btn-primary btn-sm" id="continue-btn" href="#roadmap">{{ ui.btn_continue | default('Продолжить') }}</a>
            <span class="all-done" id="all-done" hidden>{{ ui.all_done | default('Все уроки пройдены!') }}</span>
            <button class="btn btn-ghost btn-sm" id="export-btn" type="button">{{ ui.btn_export_progress | default('Экспорт (JSON)') }}</button>
            <button class="btn btn-ghost btn-sm" id="import-btn" type="button">{{ ui.btn_import_progress | default('Импорт') }}</button>
            <input type="file" id="import-file" accept=".json,application/json" style="display:none;" />
            <button class="btn btn-ghost btn-sm" id="reset-btn" type="button">{{ ui.btn_reset_progress | default('Сбросить прогресс') }}</button>
          </div>
          <div class="storage-warning" id="storage-warning" role="alert" hidden style="margin-top:0.75rem;padding:0.5rem 0.75rem;border-radius:6px;background:rgba(234,179,8,0.15);border:1px solid rgba(234,179,8,0.4);color:#eab308;font-size:0.8rem;">
            <span class="warning-icon" aria-hidden="true">⚠️ </span>
            <span class="warning-text">{{ ui.storage_warning | default('Внимание: локальное хранилище недоступно. Экспортируйте прогресс перед закрытием вкладки.') }}</span>
          </div>
        </div>
      </div>

      <div class="subway" id="subway">
        <div class="track" aria-hidden="true"><div class="track-fill" id="track-fill"></div></div>
        {% for level in levels %}
        <section class="level" aria-labelledby="level-{{ level.id }}">
          <header class="level-head reveal">
            <p class="level-name">{{ level.name }}</p>
            <h3 class="level-title" id="level-{{ level.id }}">{{ level.title }}</h3>
            <p class="level-sum">{{ level.summary }}</p>
          </header>
          <ol class="stations">
            {% for module in level.modules %}
            <li class="station reveal" data-module="{{ module.id }}" data-status="not-started">
              <span class="node" aria-hidden="true"></span>
              <article class="station-card">
                <header class="station-head">
                  <span class="station-num" aria-hidden="true">{{ module.number }}</span>
                  <div class="station-meta">
                    <h4 class="station-title">
                      <a href="{{ module.lessons[0].href if module.lessons else module.url }}">{{ module.title }}</a>
                    </h4>
                    <p class="station-tag">{{ module.tagline }}</p>
                  </div>
                  <div class="station-side">
                    <span class="station-time">{{ module.time }}</span>
                    <span class="pill" data-pill>{{ ui.status_not_started | default('Не начато') }}</span>
                  </div>
                </header>
                <div class="station-bar">
                  <span class="bar" aria-hidden="true"><i data-bar></i></span>
                  <span class="bar-count" data-count>0/{{ module.lesson_count }}</span>
                </div>
                <button
                  class="station-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls="lessons-{{ module.id }}"
                >
                  <span>{{ module.lesson_count }} {{ 'уроков' if module.lesson_count != 1 else 'урок' }}</span>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </button>
                <ul class="lessons" id="lessons-{{ module.id }}">
                  {% for lesson in module.lessons %}
                  <li class="lesson" data-lesson="{{ lesson.full_id }}" data-status="not-started">
                    <button
                      class="check"
                      type="button"
                      role="checkbox"
                      aria-checked="false"
                      aria-label="Отметить '{{ lesson.title }}' как прочитанное"
                    >
                      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path class="check-dash" d="M4 8h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        <path class="check-mark" d="M3.2 8.6 6.4 11.6 13 4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <a class="lesson-link" href="{{ lesson.href }}">{{ lesson.title }}</a>
                    <span class="lesson-status" data-lstatus>{{ ui.status_not_started | default('Не начато') }}</span>
                  </li>
                  {% endfor %}
                </ul>
              </article>
            </li>
            {% endfor %}
          </ol>
        </section>
        {% endfor %}
      </div>
    </section>

    {# ============ Get started ============ #}
    <section class="section" id="get-started">
      <p class="kicker reveal">Быстрый старт</p>
      <h2 class="section-title reveal">Пятнадцать минут до первого результата</h2>
      <ol class="steps">
        <li class="step reveal">
          <span class="step-num" aria-hidden="true">01</span>
          <h3>Склонируйте репозиторий</h3>
          <p>Все уроки, упражнения и шаблоны внутри — без скрытых сетевых сервисов.</p>
          <div class="code">
            <code>git clone {{ repo_url }}.git</code>
            <button class="copy" type="button" data-copy="git clone {{ repo_url }}.git" aria-label="Скопировать команду git clone">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                <path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" />
              </svg>
              <span class="copy-label">Скопировать</span>
            </button>
          </div>
        </li>
        <li class="step reveal" style="--d: 0.08s">
          <span class="step-num" aria-hidden="true">02</span>
          <h3>Проверьте готовность среды</h3>
          <p>Автономный скрипт проверит окружение и выполнит базовую диагностику.</p>
          <div class="code">
            <code>python scripts/verify.py</code>
            <button class="copy" type="button" data-copy="python scripts/verify.py" aria-label="Скопировать команду проверки">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                <path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" />
              </svg>
              <span class="copy-label">Скопировать</span>
            </button>
          </div>
        </li>
        <li class="step reveal" style="--d: 0.16s">
          <span class="step-num" aria-hidden="true">03</span>
          <h3>Запустите наставника в Codex CLI</h3>
          <p>В терминале Codex CLI введите команду вызова навыка наставника курса.</p>
          <div class="code">
            <code>$learn</code>
            <button class="copy" type="button" data-copy="$learn" aria-label="Скопировать вызов $learn">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                <path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" />
              </svg>
              <span class="copy-label">Скопировать</span>
            </button>
          </div>
        </li>
      </ol>
      <span class="sr-only" id="copy-status" role="status" aria-live="polite"></span>
    </section>
  </main>

  {# ============ Footer ============ #}
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-col footer-brand">
        <span style="font-weight: 700; font-size: 1.15rem; color: var(--color-brand, #2563eb);">Codex CLI Course</span>
        <p class="footer-note">
          Автономный практический справочник и курс по Codex CLI.
        </p>
      </div>
      <div class="footer-col">
        <p class="footer-head">Проект</p>
        <a href="{{ repo_url }}" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="{{ repo_url }}/blob/{{ branch }}/LICENSE" target="_blank" rel="noopener noreferrer">MIT Лицензия</a>
      </div>
      <div class="footer-col">
        <p class="footer-head">Материалы</p>
        <a href="{{ guide_url }}">Справочник</a>
        <a href="#roadmap">Учебный маршрут</a>
        {% if version %}<span class="footer-version">Codex v{{ version }}</span>{% endif %}
      </div>
    </div>
    <div class="footer-base">
      <span>codex-cli-course-ru · MIT licensed</span>
      <a href="#top" class="footer-top">Наверх ↑</a>
    </div>
  </footer>
</body>
</html>
