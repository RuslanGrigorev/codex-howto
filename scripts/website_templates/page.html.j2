{% extends "base.html.j2" %}
{% block title %}{{ page_title }} — Курс по Codex CLI{% endblock %}
{% block body %}
<div class="layout{% if toc and toc|length > 0 %} has-toc{% endif %}">
<div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>
<aside id="course-sidebar" class="course-sidebar" aria-label="Оглавление курса">
<div class="sidebar-top">
<p class="eyebrow">Оглавление</p>
<button id="sidebar-close" class="sidebar-close" type="button" aria-label="Закрыть меню">✕</button>
</div>
{% if course.get("modules") %}
<div class="sidebar-nav-mobile">
<a href="{{ base_path|default('') }}index.html#roadmap">Модули</a>
<a href="{{ base_path|default('') }}reference/index.html">Справочник</a>
<a href="{{ base_path|default('') }}materials/index.html">Материалы</a>
</div>
{% endif %}
{% for group in nav %}<details {% if group["items"]|selectattr('is_current')|list %}open{% endif %}><summary>{{ group.name }}</summary>{% for item in group["items"] %}<a href="{{ item.url }}" {% if item.is_current %}aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}</details>{% endfor %}
</aside>
<main id="content">
<nav class="breadcrumbs" aria-label="Хлебные крошки">
<ol class="breadcrumbs-list">
<li><a href="{{ base_path|default('') }}index.html">Главная</a></li>
<li class="breadcrumbs-sep" aria-hidden="true">/</li>
{% if module and module.path %}
<li><a href="{{ base_path|default('') }}{{ module.path|replace('README.md', 'index.html')|replace('.md', '.html') }}">{{ section }}</a></li>
{% else %}
<li><span>{{ section }}</span></li>
{% endif %}
{% if page_title and page_title != section %}
<li class="breadcrumbs-sep" aria-hidden="true">/</li>
<li class="breadcrumbs-current" aria-current="page">{{ page_title }}</li>
{% endif %}
</ol>
</nav>
<p class="eyebrow">{{ section }}</p>
{% if lesson %}<div class="lesson-meta"><span>{{ 'Практика в Codex' if lesson.live_required else 'Самостоятельное обучение' }}</span><span>Редакция {{ lesson.revision }}</span>{% if module %}<a href="index.html">Все уроки модуля</a>{% endif %}</div>{% endif %}
<article class="prose">{{ content|safe }}</article>
{% if material_links %}<section class="exercise-materials" aria-label="Материалы упражнения"><h2>Материалы упражнения</h2><p>Все ссылки открывают файлы из этой поставки. Решение смотрите после самостоятельной попытки.</p><div class="material-actions">{% for item in material_links %}<a class="button" href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</div></section>{% endif %}
{% if lesson %}
<section class="lesson-controls" data-lesson="{{ lesson.id }}"><h2>Ваш результат</h2>
<button id="mark-read" type="button">Отметить прочитанным</button><p id="lesson-status"></p>
<script id="lesson-data" type="application/json">{{ lesson|tojson }}</script>
{% if quiz %}<h2>Проверка знаний</h2><p>Ответьте на все вопросы. Это проверка понимания, а не замена практики.</p><script id="quiz-data" type="application/json">{{ quiz|tojson }}</script><form id="quiz-form"></form><p id="quiz-result" role="status" aria-live="polite"></p><div id="quiz-detailed-feedback" class="quiz-feedback-box" hidden></div>{% endif %}
{% if lesson.exercise_id %}<h2>Проверка упражнения</h2><p>Выполните из корня репозитория, а в автономной поставке — из каталога <code>source</code>:</p>
<pre><code>python scripts/verify.py --prepare {{ lesson.exercise_id }}
python scripts/verify.py --exercise {{ lesson.exercise_id }} --workspace .learning/workspaces/{{ lesson.exercise_id }}</code></pre>
<p>Между командами выполните задание в подготовленной папке. Затем импортируйте <code>.learning/progress.json</code> через «Мой прогресс». Автоматической синхронизации с браузером нет.</p>{% endif %}
{% if lesson.live_required %}<p class="notice">Практика этого урока требует настоящего запуска Codex. Чтение и правильные ответы не подтверждают выполнение команд. Как сохранить результат: <a href="{{ base_path }}reference/validation.html">правила проверки</a>.</p>{% endif %}
<details><summary>Пройти этот урок с наставником</summary><p>Откройте исходники курса в Codex CLI. <code>$learn</code> — навык проекта, не встроенная slash-команда.</p><pre><code>$learn {{ lesson.id }}</code></pre><p>Наставник объясняет, даёт подсказки и помогает проверить результат. Доступная модель требуется отдельно.</p></details>

<section class="cli-simulator-widget" aria-label="Офлайн-симулятор Codex CLI" data-module="{{ module.id if module else 'start' }}">
<h3>Офлайн-симулятор Codex CLI</h3>
<div class="simulator-disclaimer">⚠️ Интерактивная симуляция: не выполняет реальный Codex и не доказывает native-совместимость. Работает офлайн без API-ключей и сети.</div>
<p class="simulator-intro">Отработайте синтаксис команд, параметров и slash-команд для этого модуля (baseline 0.160.0):</p>
<div class="simulator-presets-bar">
<span class="presets-label">Быстрые команды:</span>
<div class="simulator-preset-buttons" id="sim-presets"></div>
</div>
<div class="simulator-terminal">
<div class="terminal-header">
<span class="terminal-dot dot-red"></span><span class="terminal-dot dot-yellow"></span><span class="terminal-dot dot-green"></span>
<span class="terminal-title">codex-cli-simulator v0.160.0 (offline)</span>
</div>
<div class="terminal-body" id="sim-terminal-output" role="log" aria-live="polite">
<div class="terminal-line system-line">[СИМУЛЯТОР CODEX CLI 0.160.0 ГОТОВ. Выберите быструю команду выше или введите свою. Для справки наберите help]</div>
</div>
<form class="terminal-input-bar" id="sim-terminal-form">
<span class="terminal-prompt">user@codex-lab:~$</span>
<input type="text" class="terminal-input" id="sim-input" placeholder="codex --help" autocomplete="off" spellcheck="false" aria-label="Команда для симулятора" />
<button type="submit" class="button simulator-submit">Выполнить</button>
<button type="button" class="button simulator-clear" id="sim-clear">Очистить</button>
</form>
</div>
</section>
</section>{% endif %}
<nav class="page-nav" aria-label="По урокам">{% if prev_page %}<a href="{{ prev_page.url }}"><small>Предыдущий урок</small>← {{ prev_page.title }}</a>{% endif %}{% if next_page %}<a href="{{ next_page.url }}"><small>Следующий урок</small>{{ next_page.title }} →</a>{% endif %}</nav>
<footer><p><strong>Курс по Codex CLI</strong> — независимый учебный проект, не официальный продукт OpenAI.</p>
{% if course.get("modules") %}<nav aria-label="О проекте"><a href="{{ base_path|default('') }}guide.html">О курсе</a><a href="{{ base_path|default('') }}materials/index.html">Материалы</a><a href="{{ base_path|default('') }}materials/LICENSE.html">Лицензия MIT</a><a href="{{ base_path|default('') }}NOTICE.html">Происхождение материалов</a><a href="{{ repo_url|default('https://github.com/RuslanGrigorev/codex-howto') }}">GitHub</a><a href="#top" class="back-to-top">Наверх ↑</a></nav>
<p>Материалы читаются без сети. Для работы Codex нужен доступ к выбранной модели. Совместимость и полнота описаны в <a href="{{ base_path|default('') }}reference/coverage.html">карте покрытия</a>.</p>{% endif %}</footer>
</main>
{% if toc and toc|length > 0 %}
<aside class="toc-sidebar" aria-label="На этой странице">
<div class="toc-sticky">
<div class="toc-heading">НА ЭТОЙ СТРАНИЦЕ</div>
<ul class="toc-list">
{% for item in toc %}
<li class="toc-item toc-{{ item.level }}"><a class="toc-link" href="#{{ item.anchor }}">{{ item.text }}</a></li>
{% endfor %}
</ul>
</div>
</aside>
{% endif %}
</div>
{% endblock %}
{% block footer %}{% endblock %}
